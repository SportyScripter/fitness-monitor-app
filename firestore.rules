rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Test connection document for initial boot verification
    match /test/connection {
      allow read: if true;
    }

    // User profile and subcollections
    match /users/{userId} {
      allow get, write: if isOwner(userId) && isValidId(userId);

      // Training Cycles subcollection
      match /cycles/{cycleId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(cycleId);
      }

      // Workout Logs subcollection
      match /workout_logs/{logId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(logId);
      }

      // Recovery entries subcollection
      match /recovery/{recoveryId} {
        allow read, write: if isOwner(userId) && isValidId(userId) && isValidId(recoveryId);
      }
    }
  }
}
