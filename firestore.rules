rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Domyślna blokada wszystkich innych ścieżek
    match /{document=**} {
      allow read, write: if false;
    }

    // Funkcje pomocnicze
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Dokument testowy połączenia
    match /test/connection {
      allow read: if true;
    }

    // Dokument użytkownika oraz wszystkie jego podkolekcje (cycles, workout_logs, recovery)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
